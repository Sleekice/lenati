{
  "name": "lenati",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "turbo run dev --filter=@lenati/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:push": "pnpm --filter @lenati/graph db:push",
    "db:seed": "pnpm --filter @lenati/graph seed",
    "db:validate": "pnpm --filter @lenati/graph validate"
  },
  "devDependencies": {
    "turbo": "2.3.3",
    "typescript": "5.7.2"
  }
}
